{
  "manifest_version": 3,
  "name": "feed-guard companion",
  "version": "1.1.1",
  "description": "Companion for a self-hosted feed-guard. Closes tabs on feeds your guard has put to rest; DNS alone can't end an open tab.",
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "feed-guard",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}